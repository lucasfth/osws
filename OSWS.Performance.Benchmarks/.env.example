# OSWS Performance Benchmarks Configuration
# Copy this file to .env and fill in your values

# S3 Backend Configuration (REQUIRED for Warp benchmarks)
# Use AWS S3, Cloudflare R2, or MinIO
S3Settings__AccessKeyId=your-access-key-here
S3Settings__SecretAccessKey=your-secret-key-here
S3Settings__EndpointHostname=https://s3.amazonaws.com
S3Settings__Region=auto

# Warp Benchmark Settings
WARP_CONCURRENCY=4
WARP_DURATION_SECONDS=60
WARP_WORKLOAD_PROFILE=mixed
# Optional: for self-signed TLS endpoints (MinIO/local test certs)
WARP_INSECURE_TLS=false
WARP_OSWS_USER_NAME=warp-benchmark
WARP_OSWS_ROLE_NAME=warp-benchmark-role

# VM Configuration (REQUIRED)
# OSWS runs on a remote VM controlled via a management API.
# Warp runs locally and benchmarks against the OSWS instances.
#
# VM_MANAGEMENT_URL - URL of the VM management API
# VM_OSWS_HOST      - Hostname/IP of the VM (used for display, actual endpoints come from /scale response)
VM_MANAGEMENT_URL=http://192.168.1.100:9000
VM_OSWS_HOST=192.168.1.100
VM_HEALTH_TIMEOUT_SECONDS=120

# Optional: Instance counts to benchmark (space-separated)
# INSTANCE_COUNTS="1 2 4 8"
