{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Provider": "Azure",
    "VaultUri": "https://fgrbacvault.vault.azure.net/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "OidcProviders": [
    {
      "Name": "pocketid",
      "DisplayName": "PocketID",
      "Authority": "https://YOUR_POCKETID_HOST",
      "Audience": "YOUR_CLIENT_ID"
    }
  ],
  "Encryption": {
    "DisableEncryption": false,
    "DekSizeBits": 256,
    "EnableOperationLogging": false
  },
  "Cache": {
    "DekCacheProvider": "Local",
    "DekCacheCapacity": 2500,
    "DekTtlSeconds": 0,
    "EnableFileCache": true,
    "MaxCacheSizeBytes": 10737418240,
    "CacheDirectory": null
  }
}
