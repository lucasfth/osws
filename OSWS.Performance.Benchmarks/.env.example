# OSWS Performance Benchmarks Configuration
# Copy this file to .env and fill in your values

# ── Key Vault ──────────────────────────────────────────────────────────────────
KeyVault__Provider=Azure
KeyVault__VaultUri=https://<your-vault>.vault.azure.net/
KeyVault__TenantId=
KeyVault__ClientId=
KeyVault__ClientSecret=

# ── S3 Backend (direct access — Cloudflare R2 or MinIO) ────────────────────────
# Used for s3-direct benchmark runs and corpus upload
S3Settings__AccessKeyId=
S3Settings__SecretAccessKey=
S3Settings__EndpointHostname=https://<account-id>.r2.cloudflarestorage.com
S3Settings__Region=auto

# ── Database ───────────────────────────────────────────────────────────────────
ConnectionStrings__OswsContext=Host=localhost;Port=5432;Database=osws_warp;Username=postgres;Password=postgres

# ── OSWS endpoint (local instance) ────────────────────────────────────────────
OSWS_ENDPOINT=http://localhost:5000

# ── OSWS benchmark user credentials ───────────────────────────────────────────
# Run: dotnet run -- seed-s3-credential --user-name bench-user --role-name bench-role
# Then copy the output values here.
BENCH_OSWS_ACCESS_KEY=
BENCH_OSWS_SECRET_KEY=

# ── Benchmark settings ─────────────────────────────────────────────────────────
BENCH_BUCKET=osws-benchmark
BENCH_REPETITIONS=10

# Optional: select a single benchmark to run (auth|hierarchy|unwrap|decrypt)
# BENCH_MEASUREMENT=

# Optional: override iteration/warmup counts
# BENCH_ITERATIONS=5
# BENCH_WARMUP_COUNT=1
