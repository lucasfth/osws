{
  "KeyVault": {
    "Provider": "Azure",
    "VaultUri": "https://fgrbacvault3.vault.azure.net/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "S3Settings": {
    "AccessKeyId": "minioadmin",
    "SecretAccessKey": "minioadmin",
    "EndpointHostname": "http://localhost:9000",
    "Region": "auto"
  },
  "Encryption": {
    "DisableEncryption": false,
    "DekSizeBits": 256,
    "EnableOperationLogging": false
  },
  "Cache": {
    "EnableFileCache": true,
    "MaxCacheSizeBytes": 10737418240,
    "CacheDirectory": ""
  },
  "BenchmarkSettings": {
    "S3BucketName": "osws-benchmark-test",
    "CleanupAfterRun": true,
    "UseExistingFiles": false
  },
  "ParquetSizes": {
    "Small": {
      "Columns": 5,
      "Rows": 5000
    },
    "Wide": {
      "Columns": 2000,
      "Rows": 10000
    },
    "Deep": {
      "Columns": 10,
      "Rows": 1000000
    }
  },
  "WarpSettings": {
    "Enabled": true,
    "WarpExecutablePath": "warp",
    "OswsBasePort": 5000,
    "OswsPortsPerInstance": 2,
    "InstanceCounts": [1, 2, 4, 8],
    "WarpConcurrency": 16,
    "WarpDurationSeconds": 60,
    "WorkloadProfile": "mixed",
    "ResultsDirectory": "./warp-results",
    "LoadBalancerPort": 8000,
    "LoadBalancerPortsPerMode": 2
  }
}
