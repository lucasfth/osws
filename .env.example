# Copy this file to .env and fill in your values.

# PostgreSQL connection string
OSWS_DB_CONNECTION=Host=your-db-host;Port=5432;Database=osws;Username=postgres;Password=changeme

# Azure Key Vault (set to "Internal" for dev — keys are lost on restart)
KEY_VAULT_PROVIDER=Azure
KEY_VAULT_VAULT_URI=https://your-vault.vault.azure.net/
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# S3-compatible storage (e.g. Cloudflare R2)
S3_ENDPOINT_HOSTNAME=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=auto

# OIDC provider (e.g. PocketID)
OIDC_0_NAME=pocketid
OIDC_0_DISPLAY_NAME=PocketID
OIDC_0_AUTHORITY=https://your-pocketid-host
OIDC_0_AUDIENCE=your-client-id
