# OSWS Performance Benchmarks Configuration
# Copy this file to .env and fill in your values

# S3 Backend — direct access credentials (Cloudflare R2 or MinIO)
# Used for s3-direct benchmark runs and corpus upload
S3Settings__AccessKeyId=your-access-key-here
S3Settings__SecretAccessKey=your-secret-key-here
S3Settings__EndpointHostname=https://<account-id>.r2.cloudflarestorage.com
S3Settings__Region=auto

# OSWS endpoint (local instance)
OSWS_ENDPOINT=http://localhost:5000

# OSWS benchmark user credentials
# Run: dotnet run -- seed-s3-credential --user-name bench-user --role-name bench-role
# Then copy the output values here.
BENCH_OSWS_ACCESS_KEY=
BENCH_OSWS_SECRET_KEY=

# Benchmark settings
BENCH_BUCKET=osws-benchmark
BENCH_REPETITIONS=10
